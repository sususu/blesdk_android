<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_background"
    android:orientation="vertical"
    tools:context=".ui.main.HomeFragment">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        android:background="@color/home_background"
        app:subtitleCentered="true"
        app:subtitleTextColor="@color/home_secondary"
        app:title="@string/app_name"
        app:titleCentered="true"
        app:titleTextAppearance="@style/TextAppearance.SDKDemo.Home.Toolbar"
        app:titleTextColor="@color/home_text" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/home_separator" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.SDKDemo.Home.Card">

                <LinearLayout style="@style/Widget.SDKDemo.Home.CardContent">
                    <TextView
                        style="@style/Widget.SDKDemo.Home.Heading"
                        android:text="@string/home_connection" />

                    <LinearLayout
                        android:id="@+id/status_banner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ProgressBar
                            android:id="@+id/status_progress"
                            style="?android:attr/progressBarStyleSmall"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:indeterminateTint="@color/home_accent"
                            android:visibility="gone" />

                        <ImageView
                            android:id="@+id/status_icon"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@null"
                            android:src="@android:drawable/stat_sys_data_bluetooth"
                            app:tint="@color/home_accent" />

                        <TextView
                            android:id="@+id/status_text"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:textColor="@color/home_secondary"
                            android:textSize="13sp"
                            tools:text="Connected" />
                    </LinearLayout>

                    <!-- Only device information is hidden without a selection; connection actions stay visible. -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/device_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:visibility="gone"
                        app:cardBackgroundColor="@color/home_card"
                        app:cardCornerRadius="0dp"
                        app:cardElevation="0dp"
                        app:cardPreventCornerOverlap="false"
                        app:cardUseCompatPadding="false"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <ImageView
                                android:id="@+id/device_icon"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:contentDescription="@null"
                                android:src="@android:drawable/ic_menu_my_calendar"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/device_name"
                                style="@style/Widget.SDKDemo.Home.DeviceText"
                                tools:text="Demo Watch" />

                            <TextView
                                android:id="@+id/device_mac"
                                style="@style/Widget.SDKDemo.Home.DeviceText"
                                tools:text="AA:BB:CC:DD:EE:FF" />

                            <TextView
                                android:id="@+id/device_state"
                                style="@style/Widget.SDKDemo.Home.DeviceText"
                                tools:text="Bound" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        style="@style/Widget.SDKDemo.Home.Row"
                        android:layout_marginTop="0dp">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_scan"
                            style="@style/Widget.SDKDemo.Home.Tile"
                            android:text="@string/home_scan_connect" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_bind"
                            style="@style/Widget.SDKDemo.Home.Tile"
                            android:text="@string/home_bind" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_disconnect"
                            style="@style/Widget.SDKDemo.Home.Tile"
                            android:layout_marginEnd="0dp"
                            android:text="@string/home_disconnect" />
                    </LinearLayout>
                    <LinearLayout
                        style="@style/Widget.SDKDemo.Home.Row">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_unbind"
                            style="@style/Widget.SDKDemo.Home.Tile.Destructive"
                            android:text="@string/home_unbind" />
                        <Space
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp" />
                        <Space
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.SDKDemo.Home.Card">

                <LinearLayout style="@style/Widget.SDKDemo.Home.CardContent">
                    <TextView
                        style="@style/Widget.SDKDemo.Home.Heading"
                        android:text="@string/home_health" />

                    <LinearLayout
                        style="@style/Widget.SDKDemo.Home.Row"
                        android:layout_marginTop="0dp">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_sync"
                            style="@style/Widget.SDKDemo.Home.Tile"
                            android:text="@string/sync_data" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_sync_jl"
                            style="@style/Widget.SDKDemo.Home.Tile"
                            android:text="@string/sync_data_jl" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_manual_measure_jl"
                            style="@style/Widget.SDKDemo.Home.Tile"
                            android:layout_marginEnd="0dp"
                            android:text="@string/feature_manual_measure_jl" />
                    </LinearLayout>
                    <LinearLayout
                        style="@style/Widget.SDKDemo.Home.Row">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_auto_monitoring"
                            style="@style/Widget.SDKDemo.Home.Tile"
                            android:text="@string/home_auto_monitoring" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_goals"
                            style="@style/Widget.SDKDemo.Home.Tile"
                            android:text="@string/feature_goals" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_ai_health"
                            style="@style/Widget.SDKDemo.Home.Tile"
                            android:layout_marginEnd="0dp"
                            android:text="@string/feature_ai_health" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.SDKDemo.Home.Card">

                <LinearLayout style="@style/Widget.SDKDemo.Home.CardContent">
                    <TextView
                        style="@style/Widget.SDKDemo.Home.Heading"
                        android:text="@string/home_daily" />

                    <LinearLayout
                        style="@style/Widget.SDKDemo.Home.Row"
                        android:layout_marginTop="0dp">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_alarms"
                            style="@style/Widget.SDKDemo.Home.Tile"
                            android:text="@string/feature_alarms" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_alarms_jl"
                            style="@style/Widget.SDKDemo.Home.Tile"
                            android:text="@string/feature_alarms_jl" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_notify"
                            style="@style/Widget.SDKDemo.Home.Tile"
                            android:layout_marginEnd="0dp"
                            android:text="@string/home_notify" />
                    </LinearLayout>
                    <LinearLayout
                        style="@style/Widget.SDKDemo.Home.Row">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_reminder_listener_jl"
                            style="@style/Widget.SDKDemo.Home.Tile"
                            android:text="@string/feature_reminder_listener_jl" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_electronic_card"
                            style="@style/Widget.SDKDemo.Home.Tile"
                            android:text="@string/feature_electronic_card" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_lift_wrist"
                            style="@style/Widget.SDKDemo.Home.Tile"
                            android:layout_marginEnd="0dp"
                            android:text="@string/home_lift_wrist" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.SDKDemo.Home.Card">

                <LinearLayout style="@style/Widget.SDKDemo.Home.CardContent">
                    <TextView
                        style="@style/Widget.SDKDemo.Home.Heading"
                        android:text="@string/home_media" />

                    <LinearLayout
                        style="@style/Widget.SDKDemo.Home.Row"
                        android:layout_marginTop="0dp">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_watchface"
                            style="@style/Widget.SDKDemo.Home.Tile"
                            android:text="@string/feature_watchface" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_watchface_jieli"
                            style="@style/Widget.SDKDemo.Home.Tile"
                            android:text="@string/feature_watchface_jl" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_music"
                            style="@style/Widget.SDKDemo.Home.Tile"
                            android:layout_marginEnd="0dp"
                            android:text="@string/feature_music" />
                    </LinearLayout>
                    <LinearLayout
                        style="@style/Widget.SDKDemo.Home.Row">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_album"
                            style="@style/Widget.SDKDemo.Home.Tile"
                            android:text="@string/feature_album" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_ai"
                            style="@style/Widget.SDKDemo.Home.Tile"
                            android:text="@string/feature_ai" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_watchface_studio"
                            style="@style/Widget.SDKDemo.Home.Tile"
                            android:layout_marginEnd="0dp"
                            android:text="@string/feature_watchface_studio" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.SDKDemo.Home.Card"
                android:layout_marginBottom="0dp">

                <LinearLayout style="@style/Widget.SDKDemo.Home.CardContent">
                    <TextView
                        style="@style/Widget.SDKDemo.Home.Heading"
                        android:text="@string/home_maintenance" />

                    <LinearLayout
                        style="@style/Widget.SDKDemo.Home.Row"
                        android:layout_marginTop="0dp">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_agps"
                            style="@style/Widget.SDKDemo.Home.Tile"
                            android:text="@string/feature_agps" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_ota"
                            style="@style/Widget.SDKDemo.Home.Tile"
                            android:text="@string/feature_ota" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_ota_jieli"
                            style="@style/Widget.SDKDemo.Home.Tile"
                            android:layout_marginEnd="0dp"
                            android:text="@string/feature_ota_jl" />
                    </LinearLayout>
                    <LinearLayout
                        style="@style/Widget.SDKDemo.Home.Row">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_offline_map"
                            style="@style/Widget.SDKDemo.Home.Tile"
                            android:text="@string/feature_offline_map" />
                        <Space
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp" />
                        <Space
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Collapsible activity log panel, pinned below the feature cards. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/log_card"
        style="@style/Widget.SDKDemo.Home.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/log_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="14dp">

                <TextView
                    android:id="@+id/log_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/home_logs_title"
                    android:textColor="@color/home_text"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/log_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_log_count"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:textColor="@color/home_secondary"
                    android:textSize="12sp"
                    android:visibility="gone"
                    tools:text="12"
                    tools:visibility="visible" />

                <ImageView
                    android:id="@+id/log_expand_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/home_show_logs"
                    android:src="@drawable/ic_expand_chevron"
                    app:tint="@color/home_secondary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/log_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/home_separator" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:background="@color/home_tile">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/log_list"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:overScrollMode="ifContentScrolls"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="8dp"
                        android:scrollbars="vertical"
                        tools:listitem="@layout/item_log" />

                    <TextView
                        android:id="@+id/log_empty"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:padding="16dp"
                        android:text="@string/home_logs_empty"
                        android:textColor="@color/home_secondary"
                        android:textSize="13sp"
                        android:visibility="gone"
                        tools:visibility="visible" />
                </FrameLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_clear_logs"
                    style="@style/Widget.SDKDemo.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp"
                    android:text="@string/home_logs_clear"
                    android:textColor="@color/home_accent" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Keep synchronization results outside the scrolling cards, pinned to the bottom. -->
    <TextView
        android:id="@+id/sync_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingBottom="8dp"
        android:textColor="@color/home_accent"
        android:visibility="gone"
        tools:text="Activities 3 (steps 1200)"
        tools:visibility="visible" />
</LinearLayout>
