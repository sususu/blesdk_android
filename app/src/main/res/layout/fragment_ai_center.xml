<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        android:background="@color/home_background"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:navigationIconTint="@color/home_accent"
        app:title="@string/feature_ai"
        app:titleCentered="true"
        app:titleTextAppearance="@style/TextAppearance.SDKDemo.Home.Toolbar"
        app:titleTextColor="@color/home_text" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/home_separator" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
            <com.google.android.material.card.MaterialCardView style="@style/Widget.SDKDemo.Home.Card">
                <LinearLayout style="@style/Widget.SDKDemo.Home.CardContent">
                    <TextView
                        style="@style/Widget.SDKDemo.Home.DeviceText"
                        android:text="@string/ai_menu_hint" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView style="@style/Widget.SDKDemo.Home.Card">
                <LinearLayout style="@style/Widget.SDKDemo.Home.CardContent">
                    <TextView
                        style="@style/Widget.SDKDemo.Home.Heading"
                        android:text="@string/ui_actions" />
                    <LinearLayout
                        style="@style/Widget.SDKDemo.Home.Row"
                        android:layout_marginTop="0dp">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_guide"
                            style="@style/Widget.SDKDemo.Home.Tile"
                            android:text="@string/ai_menu_guide" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_open_demo"
                            style="@style/Widget.SDKDemo.Home.Tile"
                            android:text="@string/ai_menu_demo" />
                        <Space
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView style="@style/Widget.SDKDemo.Home.Card">
                <LinearLayout style="@style/Widget.SDKDemo.Home.CardContent">
                    <TextView
                        style="@style/Widget.SDKDemo.Home.Heading"
                        android:text="@string/ai_analysis_title" />
                    <LinearLayout
                        style="@style/Widget.SDKDemo.Home.Row"
                        android:layout_marginTop="0dp">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_health"
                            style="@style/Widget.SDKDemo.Home.Tile"
                            android:text="@string/ai_menu_health" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_insight"
                            style="@style/Widget.SDKDemo.Home.Tile"
                            android:text="@string/ai_menu_insight" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_body"
                            style="@style/Widget.SDKDemo.Home.Tile"
                            android:layout_marginEnd="0dp"
                            android:text="@string/ai_menu_body" />
                    </LinearLayout>
                    <LinearLayout
                        style="@style/Widget.SDKDemo.Home.Row">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_sleep_day"
                            style="@style/Widget.SDKDemo.Home.Tile"
                            android:text="@string/ai_menu_sleep_day" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_sleep_week"
                            style="@style/Widget.SDKDemo.Home.Tile"
                            android:text="@string/ai_menu_sleep_week" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_sleep_month"
                            style="@style/Widget.SDKDemo.Home.Tile"
                            android:layout_marginEnd="0dp"
                            android:text="@string/ai_menu_sleep_month" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
