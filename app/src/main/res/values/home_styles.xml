<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Card-based demo UI tokens; legacy feature widgets and the app theme remain unchanged. -->
    <style name="TextAppearance.SDKDemo.Home.Toolbar" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.SDKDemo.Home.Card" parent="Widget.MaterialComponents.CardView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">20dp</item>
        <item name="cardBackgroundColor">@color/home_card</item>
        <item name="cardCornerRadius">14dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardUseCompatPadding">false</item>
        <item name="cardPreventCornerOverlap">false</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.SDKDemo.Home.CardContent" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <style name="Widget.SDKDemo.Home.Heading" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/home_text</item>
    </style>

    <style name="Widget.SDKDemo.Home.DeviceText" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/home_secondary</item>
    </style>

    <style name="Widget.SDKDemo.Home.Row" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:baselineAligned">false</item>
    </style>

    <style name="Widget.SDKDemo.Home.Tile" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">0dp</item>
        <!-- The row wraps its tallest label, then stretches its buttons to the same height. -->
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingHorizontal">6dp</item>
        <item name="android:paddingVertical">8dp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
        <item name="textAllCaps">false</item>
        <item name="android:singleLine">false</item>
        <item name="android:scrollHorizontally">false</item>
        <item name="android:ellipsize">none</item>
        <item name="android:gravity">center</item>
        <item name="autoSizeTextType">none</item>
        <item name="android:autoSizeTextType">none</item>
        <item name="android:textColor">@color/home_button_text</item>
        <item name="backgroundTint">@color/home_button_background</item>
        <item name="cornerRadius">10dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.SDKDemo.Home.Tile.Primary" parent="Widget.SDKDemo.Home.Tile">
        <item name="backgroundTint">@color/home_primary_button_background</item>
        <item name="android:textColor">@color/home_primary_button_text</item>
    </style>

    <style name="Widget.SDKDemo.Home.Tile.Destructive" parent="Widget.SDKDemo.Home.Tile">
        <item name="android:textColor">@color/home_destructive_button_text</item>
    </style>
</resources>
